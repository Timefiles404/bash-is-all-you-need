# secrets — never commit a key
.env
*.local

# build output
/agent
/agent.exe
bin/
# every stage builds from <stage>/code, so an unnamed `go build` drops a binary
# called `code` next to wherever you ran it.
/code
code.exe

# session traces (stage 02+)
*.jsonl
traces/

# scratch dirs used while testing the agent
sandbox/

# local provider config (may name real endpoints)
providers.json

# scratch space for experiments and subagent work
.work/

# stray binaries from a cross-compile, which have no extension at all
*.exe
