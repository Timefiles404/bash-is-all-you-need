# secrets — never commit a key
.env
*.local

# build output
/agent
/agent.exe
bin/

# session traces (stage 02+)
*.jsonl
traces/

# scratch dirs used while testing the agent
sandbox/

# local provider config (may name real endpoints)
providers.json

# scratch space for experiments and subagent work
.work/

# stray stage binaries from `go build ./stages/...`
# *.exe covers Windows; a cross-compiled one has no extension at all,
# and the GOOS=linux/darwin builds in AGENTS.md produce exactly that.
*.exe
/[0-9][0-9]-*
